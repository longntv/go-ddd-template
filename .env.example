# Copy to .env and adjust. Values below match docker/docker-compose.yaml.
# Load into your shell with: set -a; . ./.env; set +a

# App
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=go_ddd_template
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600

# AWS (LocalStack). Remove AWS_ENDPOINT_URL to use real AWS.
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Created by docker/localstack/init-aws.sh
S3_BUCKET_NAME=go-ddd-template-bucket
S3_BUCKET_PREFIX=uploads/
SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-1:000000000000:user-events
SQS_QUEUE_URL=http://localhost:4566/000000000000/user-events
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20

# Bedrock
BEDROCK_REGION=ap-northeast-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Datadog
DD_ENABLED=false
DD_SERVICE_NAME=go-ddd-template
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126

# Integration tests (internal/testutil): prefix for throwaway test databases
TEST_DB_NAME_PREFIX=go_ddd_template_test
